# MongoDB Connection String
# For local MongoDB (make sure MongoDB is installed and running):
MONGODB_URI=mongodb://localhost:27017/crowdspark

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/crowdspark?retryWrites=true&w=majority

# Server Port (optional, defaults to 3001)
PORT=3001

# Email Configuration (ZeptoMail / SMTP)
ZEPTOMAIL_API_KEY=your_zeptomail_send_mail_token
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=CrowdSpark

# Fallback SMTP (optional if using Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# AI Quiz Generator API Keys (At least one is required to use AI generation)
OPENAI_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key
GEMINI_API_KEY=your_gemini_api_key

